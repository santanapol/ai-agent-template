{
  "name": "reference",
  "version": "0.1.0",
  "private": true,
  "description": "Reference upstream API (GET /api/v1/me + items CRUD) following std.min",
  "type": "commonjs",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "TZ=UTC node --watch --enable-source-maps src/server.js",
    "start": "TZ=UTC node --enable-source-maps src/server.js",
    "test": "NODE_ENV=test TZ=UTC jest --runInBand",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spec:lint": "spectral lint openapi.yaml --ruleset .spectral.yaml",
    "audit:check": "npm audit --audit-level=high",
    "ci": "npm run format:check && npm run lint && npm run spec:lint && npm test && npm run audit:check"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "mongodb": "^7.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@stoplight/spectral-cli": "^6.15.0",
    "eslint": "^9.25.1",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.0",
    "supertest": "^7.1.0"
  }
}
