{
  "name": "auth",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "start": "TZ=UTC node --enable-source-maps --env-file=.env src/server.js",
    "dev": "TZ=UTC node --enable-source-maps --watch --env-file=.env src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spec:lint": "spectral lint openapi.yaml --ruleset .spectral.yaml --fail-severity=error",
    "spec:codes": "node scripts/validate-auth-openapi-problem-codes.mjs",
    "test": "TZ=UTC node --enable-source-maps --test --test-timeout=120000 test/**/*.test.js",
    "test:coverage": "c8 --reporter=text --reporter=html node --test --test-timeout=120000 test/**/*.test.js",
    "audit:check": "npm audit --audit-level=high",
    "ci": "npm run lint && npm run format:check && npm run spec:lint && npm run spec:codes && npm test && npm run audit:check",
    "seed:user": "node --env-file=.env scripts/seed-user.mjs",
    "seed:example": "node --env-file=.env scripts/seed-example-data.mjs",
    "init:db": "node --env-file=.env scripts/init-db.mjs",
    "create-env": "node scripts/create-dev-env.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "argon2": "^0.41.1",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "joi": "^17.13.3",
    "jose": "^5.10.0",
    "mongodb": "^6.12.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@stoplight/spectral-cli": "^6.15.1",
    "c8": "^10.1.3",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "mongodb-memory-server": "^10.1.4",
    "prettier": "^3.5.3"
  }
}
