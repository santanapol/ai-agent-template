# Local dev: browser calls Auth (login) and Gateway (API) on different origins.
# Enable CORS on both services, e.g. auth and gateway `CORS_ORIGINS`:
#   http://localhost:5173,http://127.0.0.1:5173
#
# Auth default listen: PORT=3001 (see auth/)
# Gateway default listen: PORT=3002 (see gateway/)

VITE_AUTH_BASE_URL=http://127.0.0.1:3001
VITE_API_BASE_URL=http://127.0.0.1:3002

# Playwright (optional): must match Vite origin used in playwright.config.ts webServer
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173
