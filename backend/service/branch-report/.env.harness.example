# =============================================================================
# branch-report — harness environment example
# =============================================================================
# dev-up loads .env.harness (gitignored). First time: cp .env.harness.example .env.harness
# Put Atlas / read URIs in .env.harness — dev-up only refreshes port/DB/route keys.
# Guide: backend/ENV.md

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# ใน monorepo zero-platform port 3015 คู่กับ `gateway` ROUTES_JSON
PORT=3104
TZ=UTC
NODE_ENV=development
APP_NAME=branch-report

# -----------------------------------------------------------------------------
# Gateway / Internal Trust
# -----------------------------------------------------------------------------
# ต้องตรงกับ `GATEWAY_SECRET` ใน `gateway/.env`
GATEWAY_SHARED_SECRET=test-gateway-secret-32-chars-minimum!!

# -----------------------------------------------------------------------------
# Read databases (branch master — su_branch ใน gpp_777ww)
# -----------------------------------------------------------------------------
# Local harness (seed writes here): keep 127.0.0.1 — see backend/ENV.md
# Atlas read-only demo: put mongodb+srv in .env.harness instead; seed will skip.
# production: Atlas read replica (zero-api-read) — ชุดเดียวกับ auth `MONGODB_URI_READ`
MONGODB_URI_READ=mongodb://127.0.0.1:27017
MONGODB_DB_BRANCH=gpp_777ww

