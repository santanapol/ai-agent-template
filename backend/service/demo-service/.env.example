# =============================================================================
# demo-service — environment example
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# ใน monorepo zero-platform ใช้ 3002 คู่กับ `gateway` ROUTES_JSON (ดู `local-ports.md`)
PORT=3002
TZ=UTC
NODE_ENV=development
APP_NAME=demo-service

# -----------------------------------------------------------------------------
# Gateway / Internal Trust
# -----------------------------------------------------------------------------
# ต้องตรงกับ `GATEWAY_SECRET` ใน `gateway/.env` (และ upstream อื่นที่ใช้ secret เดียวกัน เช่น staff)
GATEWAY_SHARED_SECRET=test-gateway-secret-32-chars-minimum!!

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://demo-service:demo-service@localhost:27017/demo-service?authSource=demo-service
DB_NAME=demo-service

# -----------------------------------------------------------------------------
# Optional tuning
# -----------------------------------------------------------------------------
RATE_LIMIT_STORE=memory
MAX_POOL_SIZE=10
MIN_POOL_SIZE=2
# REQUEST_TIMEOUT_MS=30000
# APP_VERSION=0.1.0

# Optional logging (dev defaults to pino-pretty; set LOG_PRETTY=false for JSON lines)
# LOG_LEVEL=info
# LOG_PRETTY=false

# Seed scripts (scripts/seed-example-data.mjs) — hex24 จาก auth `npm run seed:example` สำหรับ gateway E2E
# SEED_OU_ID=
# SEED_BRANCH_ID=
# SEED_USER_ID=demo
