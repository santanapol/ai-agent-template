{
  "name": "staff-service",
  "version": "0.1.0",
  "private": true,
  "description": "Staff profile internal API (staff_profiles) — Fastify + Mongo behind gateway",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --enable-source-maps src/server.js",
    "start": "node --env-file-if-exists=.env --enable-source-maps src/server.js",
    "test": "NODE_ENV=test node --env-file-if-exists=.env --test --test-concurrency=1",
    "test:coverage": "NODE_ENV=test node --env-file-if-exists=.env --experimental-test-coverage --test",
    "coverage:gate": "node scripts/coverage-gate.mjs",
    "ci:with-coverage": "npm run ci && npm run coverage:gate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spec:lint": "spectral lint openapi.yaml --ruleset .spectral.yaml && spectral lint openapi-via-gateway.yaml --ruleset .spectral.yaml",
    "audit:check": "npm audit --audit-level=high",
    "prepare": "husky",
    "ci": "npm run lint && npm run format:check && npm test && npm run audit:check",
    "init:db": "node --env-file-if-exists=.env scripts/init-db.mjs",
    "seed:example": "node --env-file-if-exists=.env scripts/seed-example-data.mjs"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@zero-platform/roles": "file:../../shared/platform-roles",
    "axios": "^1.7.2",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.1.0",
    "mongodb": "^7.2.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@stoplight/spectral-cli": "^6.15.0",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
