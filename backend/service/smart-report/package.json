{
  "name": "smart-report-service",
  "version": "0.1.0",
  "private": true,
  "description": "Smart Report Service — scheduled MongoDB query scripts exported to CSV/Excel",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "NODE_ENV=test TZ=UTC node --env-file-if-exists=.env --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:check": "npm audit --audit-level=high",
    "ci": "npm run lint && npm run format:check && npm test && npm run audit:check",
    "init:db": "node --env-file-if-exists=.env scripts/init-db.mjs",
    "seed:example": "node --env-file-if-exists=.env scripts/seed-example-data.mjs",
    "migrate:scripts": "node --env-file-if-exists=.env scripts/migrate-report-scripts.mjs"
  },
  "dependencies": {
    "@zero-platform/roles": "file:../../shared/platform-roles",
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.5",
    "exceljs": "^4.4.0",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "json2csv": "^5.0.7",
    "mongodb": "^7.2.0",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.1.0",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.1"
  }
}
