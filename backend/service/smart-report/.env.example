# MongoDB — local read/write (reports metadata, download_history)
MONGODB_URI=mongodb://localhost:27017
DB_NAME=zero-smart-report

# MongoDB — read-only (report script queries; prod read replica in production)
MONGODB_URI_READ=mongodb://localhost:27017

# Report script execution timeout (ms) — Test Run, Manual run, Scheduler
REPORT_SCRIPT_TIMEOUT_MS=120000

# Test run token (required in production)
# TEST_RUN_TOKEN_SECRET=change-me-in-production
# TEST_RUN_TOKEN_TTL_MS=900000
