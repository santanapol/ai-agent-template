# =============================================================================
# smart-report — harness environment example
# =============================================================================
# dev-up loads .env.harness (gitignored). First time: cp .env.harness.example .env.harness
# Put Atlas / read URIs in .env.harness — dev-up only refreshes port/DB/route keys.
# Guide: backend/ENV.md

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# ใน monorepo zero-platform port 3103 คู่กับ `gateway` ROUTES_JSON
PORT=3103
TZ=UTC
NODE_ENV=development
APP_NAME=smart-report

# -----------------------------------------------------------------------------
# Gateway / Internal Trust
# -----------------------------------------------------------------------------
# ต้องตรงกับ `GATEWAY_SECRET` ใน `gateway/.env`
GATEWAY_SHARED_SECRET=test-gateway-secret-32-chars-minimum!!

# -----------------------------------------------------------------------------
# Database Configuration (Primary — report metadata & download history, R/W)
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/zero-smart-report
DB_NAME=zero-smart-report

# -----------------------------------------------------------------------------
# Read databases (GPP script queries — read-only)
# -----------------------------------------------------------------------------
# production: Atlas read replica (zero-api-read) — ชุดเดียวกับ auth `MONGODB_URI_READ`
MONGODB_URI_READ=mongodb://127.0.0.1:27017

# -----------------------------------------------------------------------------
# Report script sandbox & save gate
# -----------------------------------------------------------------------------
REPORT_SCRIPT_TIMEOUT_MS=120000
TEST_RUN_TOKEN_SECRET=change-me-in-production
# TEST_RUN_TOKEN_TTL_MS=900000

