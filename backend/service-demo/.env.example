# ใน monorepo zero-platform ใช้ 3003 คู่กับ `gateway` ROUTES_JSON (ดู `local-ports.md`)
PORT=3003
TZ=UTC
NODE_ENV=development
DB_NAME=api_example
MONGODB_URI=mongodb://api-example:api-example@localhost:27017/api_example?authSource=api_example
# ต้องตรงกับ `GATEWAY_SECRET` ใน `gateway/.env` (และ upstream อื่นที่ใช้ secret เดียวกัน เช่น staff)
GATEWAY_SHARED_SECRET=test-gateway-secret-32-chars-minimum!!
RATE_LIMIT_STORE=memory
MAX_POOL_SIZE=10
MIN_POOL_SIZE=2
# HTTP server idle/request timeout (ms); aligns with api.md default 30000
# REQUEST_TIMEOUT_MS=30000
# Optional; defaults to package.json version for structured logs
# APP_VERSION=0.1.0

# Optional logging (dev defaults to pino-pretty; set LOG_PRETTY=false for JSON lines)
# LOG_LEVEL=info
# LOG_PRETTY=false
