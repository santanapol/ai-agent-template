# =============================================================================
# gateway — environment template
# คัดลอกเป็น `.env` แล้วแก้ค่า — ห้าม commit secret production
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3000
TRUST_PROXY=false

# RFC 7807 `type` base URI (gateway edge errors)
# PROBLEM_TYPE_BASE=https://example.invalid/gateway/problems
# READY_CHECK_TIMEOUT_MS=2000
# LOG_LEVEL=info
# LOG_PRETTY=true

# -----------------------------------------------------------------------------
# JWT verify (JWKS only — ห้ามตั้ง JWT_SECRET)
# -----------------------------------------------------------------------------
# ต้องตรงกับ JWKS ของ auth (ลงท้าย `/.well-known/jwks.json`)
JWT_JWKS_URL=http://127.0.0.1:3001/.well-known/jwks.json

# ถ้าตั้งแล้ว ต้องตรงกับ access token ที่ auth ออก
# JWT_ISSUER=https://auth.example.invalid
# JWT_AUDIENCE=gateway

JWT_CLAIM_USER_ID=sub
JWT_CLAIM_ROLE=role
# JWT_LEEWAY_SECONDS=60

# -----------------------------------------------------------------------------
# Redis (D3 — required in production; compare JWT `token_gen` to `user:{sub}:token_gen`)
# -----------------------------------------------------------------------------
# Local: `docker compose up -d redis` จาก monorepo root `zero-platform/` (RUNBOOK.md §2.5)
# production (NODE_ENV=production): ต้องตั้ง — ให้ตรงกับ auth `REDIS_URL` (instance เดียวกัน)
# dev: แนะนำตั้งเมื่อทดสอบ login/proxy + immediate revoke (`token_gen` gate เปิดเมื่อมี URL)
# CI: ว่างได้ (ข้าม Redis gate)
REDIS_URL=redis://127.0.0.1:6379/0

# -----------------------------------------------------------------------------
# Gateway → upstream trust contract
# -----------------------------------------------------------------------------
# ควรใช้ random ≥ 32 bytes — ต้องตรงกับค่าที่ upstream ทุกตัวที่ตรวจ `x-gateway-secret` / `GATEWAY_SHARED_SECRET` (เช่น demo-service, staff)
# Placeholder เดียวกับ `services/.demo/demo-service/.env.example` — แก้เป็น secret จริงก่อน production
GATEWAY_SECRET=test-gateway-secret-32-chars-minimum!!

# -----------------------------------------------------------------------------
# Proxy / limits
# -----------------------------------------------------------------------------
UPSTREAM_TIMEOUT_MS=30000
MAX_BODY_BYTES=1048576

# ตั้งอย่างใดอย่างหนึ่งเท่านั้น: ROUTES_JSON หรือ ROUTES_FILE
# Node `--env-file` ไม่ override ตัวแปรที่ export ไว้ใน shell แล้ว — `server.js` จะอ่าน `ROUTES_JSON` / `ROUTES_FILE` จาก `gateway/.env` (หา path จากแพ็กเกจ ไม่ใช่แค่ cwd) ก่อน `loadEnv` เพื่อให้ตาราง route ตรงกับไฟล์ (ยัง `unset ROUTES_JSON` ได้ถ้าต้องการ)
# Longest prefix ก่อน (ดู `src/config/routes.js`): `/api/v1/staff` → staff :3101; `/api/v1/items` + `/api/v1/me` → demo-service :3002
# stripPrefix false — path ที่ client ยิงตรงกับที่ upstream รับ
# ตัวอย่าง access-platform (ไฟล์ `gateway/routes.json` ใน repo นี้ใช้ชุดเดียวกัน):
ROUTES_JSON=[{"prefix":"/api/v1/staff","upstream":"http://127.0.0.1:3101","stripPrefix":false},{"prefix":"/api/v1/items","upstream":"http://127.0.0.1:3002","stripPrefix":false},{"prefix":"/api/v1/me","upstream":"http://127.0.0.1:3002","stripPrefix":false},{"prefix":"/api/v1/agent-invoice","upstream":"http://127.0.0.1:3102","stripPrefix":false},{"prefix":"/api/v1/invoices","upstream":"http://127.0.0.1:3102","stripPrefix":false},{"prefix":"/auth","upstream":"http://127.0.0.1:3001","stripPrefix":false,"isPublic":true}]
# mock echo (GET /api/ping → upstream /ping): [{"prefix":"/api","upstream":"http://127.0.0.1:4000","stripPrefix":true}]
# Same routes as JSON file (use **either** ROUTES_JSON **or** ROUTES_FILE — not both):
# ROUTES_FILE=./routes.example.json

# -----------------------------------------------------------------------------
# CORS (ว่าง = ปิด) — เปิดเมื่อมี browser SPA dev จาก origin อื่น (คั่นด้วย comma)
# -----------------------------------------------------------------------------
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Shutdown
# -----------------------------------------------------------------------------
# SHUTDOWN_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# ลอง proxy ครบ (auth + upstream + gateway)
# -----------------------------------------------------------------------------
# Terminal 1: auth               `npm start`           (:3001)
# Terminal 2: `services/.demo/demo-service`  `npm run dev`         (:3002, GATEWAY_SHARED_SECRET=GATEWAY_SECRET)
# Terminal 2b: `services/staff`     (เมื่อ implement)   (:3101, same secret + Mongo)
# Terminal 3: gateway            `npm start`           (:3000)
# Terminal 4: `npm run try:proxy`  (login demo → GET /api/v1/me)
#
# Optional: TRY_AUTH_URL, TRY_GATEWAY_URL, TRY_PROXY_PATH, TRY_LOGIN_USERNAME, TRY_LOGIN_PASSWORD
