{
  "name": "gateway",
  "version": "0.2.4",
  "private": true,
  "description": "API Gateway — verify JWT (JWKS), inject trusted headers, proxy to upstreams",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "start": "TZ=UTC node --enable-source-maps --env-file=.env src/server.js",
    "dev": "TZ=UTC node --enable-source-maps --watch --env-file=.env src/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spec:lint": "npx -y @stoplight/spectral-cli lint openapi.yaml --ruleset .spectral.yaml",
    "spec:codes": "node scripts/validate-gateway-openapi-problem-codes.mjs",
    "audit:check": "npm audit --audit-level=high",
    "ci": "npm run lint && npm run format:check && npm run spec:lint && npm run spec:codes && npm test && npm run audit:check",
    "test": "TZ=UTC node --enable-source-maps --test --test-timeout=120000 test/*.test.js test/*/*.test.js",
    "test:coverage": "c8 --reporter=text --reporter=html node --test --test-timeout=120000 test/**/*.test.js",
    "dev:upstream": "node scripts/dev-upstream.mjs",
    "try:proxy": "node scripts/try-proxy.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/http-proxy": "^11.4.4",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "jose": "^5.10.0",
    "pino-pretty": "^13.1.3",
    "redis": "^4.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "c8": "^11.0.0",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "prettier": "^3.5.3"
  }
}
