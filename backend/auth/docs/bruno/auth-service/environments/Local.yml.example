name: Local
variables:
  - name: baseUrl
    value: http://127.0.0.1:{{port}}
  - name: port
    value: '3001'
  - name: internalServiceSecret
    value: ''
    secret: true
  - name: userId
    value: ''
    description: |
      Must equal JWT `sub` from **Login** (MongoDB `users._id`, 24-hex).
      Wrong id → 404 AUTH_USER_NOT_FOUND. Not staff profile id.
