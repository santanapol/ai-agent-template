# =============================================================================
# auth — environment example
# =============================================================================
# Which file to edit?  backend/ENV.md
# Manual dev: cp .env.example → .env  |  Harness: dev-up uses .env.harness

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3001
TZ=UTC
NODE_ENV=development
APP_NAME=auth

# อยู่หลัง reverse proxy ให้ตั้ง true เพื่อให้ `request.ip` / trust ถูกต้อง
TRUST_PROXY=false

# Log (Pino) — LOG_PRETTY=true เปิดสี/จัดรูปแบบใน dev; ไม่ตั้งหรือ false = JSON (harness dev ใช้ false)
# LOG_LEVEL=info
# LOG_PRETTY=true

# -----------------------------------------------------------------------------
# MongoDB (ล็อก SoT — user / refresh / throttle / audit)
# -----------------------------------------------------------------------------
# connection string รวมชื่อ database (เช่น auth_login)
DATABASE_URI=mongodb://127.0.0.1:27017/auth_login
# ถ้าใช้ database เดียวกับบริการอื่น ต้องให้ MongoDB user **มีสิทธิ์ read/write** บน database นั้น
# สำหรับ collection `auth_*` — ไม่เช่นนั้น `init-db` / login จะได้ `not authorized ... $db: "<name>"` (code 13)

# หลังตั้ง URI แล้ว — สร้าง user ตัวอย่าง + index: `npm run seed:example` (ดูรหัสชั่วคราวใน stdout)

# -----------------------------------------------------------------------------
# Branch master (read-only — su_branch ใน gpp_777ww)
# -----------------------------------------------------------------------------
# ใช้สำหรับ validate สาขาตอน POST /auth/me/active-branch
# MONGODB_URI_READ=mongodb://127.0.0.1:27017/?readPreference=secondaryPreferred
# MONGODB_DB_BRANCH=gpp_777ww

# -----------------------------------------------------------------------------
# JWT access (asymmetric RS256) + JWKS public URL
# -----------------------------------------------------------------------------
# PKCS#8 PEM สำหรับ sign access JWT — ห้าม commit ค่าจริง
# แบบบรรทัดเดียว: ใช้ `\n` แทนขึ้นบรรทัด (ตัวโหลดในแอปจะแปลงให้)
# สร้างคู่ key: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl pkcs8 -topk8 -nocrypt
JWT_PRIVATE_KEY_PEM=

# URL เต็มของ JWKS — ลงท้ายด้วย `/.well-known/jwks.json` และต้องตรงกับ JWT_JWKS_URL บน gateway
JWKS_PUBLIC_URL=https://auth.example.invalid/.well-known/jwks.json

# ออก token ให้ตรงกับที่ gateway verify (ว่างได้ถ้าไม่บังคับ claim)
JWT_ISSUER=https://auth.example.invalid
JWT_AUDIENCE=gateway

# ชื่อ claim ใน JWT (ค่า default ตรงกับ gateway `docs/architecture.md`)
JWT_CLAIM_USER_ID=sub
JWT_CLAIM_ROLE=role

# JWT header `kid` — ตรงกับคีย์ใน JWKS
JWT_KID=default

# -----------------------------------------------------------------------------
# Token TTL (วินาที)
# -----------------------------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# -----------------------------------------------------------------------------
# Argon2id (รหัสผ่านใน MongoDB)
# -----------------------------------------------------------------------------
ARGON2_MEMORY_KIB=65536
ARGON2_TIME=3
ARGON2_PARALLELISM=4

# -----------------------------------------------------------------------------
# Refresh channel (browser vs native — ล็อก O-04)
# -----------------------------------------------------------------------------
# ชื่อ cookie สำหรับ refresh เมื่อ client_kind เป็น browser (default)
REFRESH_COOKIE_NAME=refresh_token

# localhost ไม่มี HTTPS — dev ใช้ false; production หลัง TLS ให้ true
COOKIE_SECURE=false

# คั่นด้วย comma — ว่าง = ปิด CORS (เปิดเมื่อมี browser SPA dev จาก origin อื่น)
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Internal service API (O-16 — trusted callers only)
# -----------------------------------------------------------------------------
# Bearer secret for POST /internal/users/{user_id}/sessions/revoke — แยกจาก gateway mesh secret
AUTH_INTERNAL_SERVICE_SECRET=change-me-internal-service-secret-min-16

# -----------------------------------------------------------------------------
# Redis (D1 — required in production; gateway reads `user:{sub}:token_gen`)
# -----------------------------------------------------------------------------
# Local: `docker compose up -d redis` จาก `access-platform/` (ดู RUNBOOK.md §2.5)
# production (NODE_ENV=production): ต้องตั้ง — ให้ตรงกับ gateway `REDIS_URL` (instance เดียวกัน)
# dev/CI: ว่างได้ถ้าไม่ทดสอบ Redis publish / immediate revoke E2E
REDIS_URL=redis://127.0.0.1:6379/0

# -----------------------------------------------------------------------------
# Errors (RFC 7807 `type` URI prefix)
# -----------------------------------------------------------------------------
PROBLEM_TYPE_BASE=https://auth.example.invalid/problems

# -----------------------------------------------------------------------------
# Integration tests (optional)
# -----------------------------------------------------------------------------
# ถ้าตั้งแล้ว เทสจะไม่ใช้ MongoMemoryReplSet — ต้องเป็น replica set ถ้าแอปใช้ transaction
# TEST_DATABASE_URI=mongodb://127.0.0.1:27017/auth_integration_test?replicaSet=rs0
