meta {
  name: Get item by id
  type: http
  seq: 3
  tags: [
    items
  ]
}

get {
  url: {{baseUrl}}/api/v1/items/:itemId
  body: none
  auth: apikey
}

params:path {
  itemId: {{item_id}}
}

headers {
  x-user-ou: {{ou_id}}
  x-user-branch: {{branch_id}}
  x-user-id: {{user_id}}
}

auth:apikey {
  key: x-gateway-secret
  value: {{apiKey}}
  placement: header
}

docs {
  Returns one item when it exists within the caller tenant scope.
}

example {
  name: 200 Response
  description: Success
  
  request: {
    url: {{baseUrl}}/api/v1/items/:itemId
    method: GET
    mode: none
    params:path: {
      itemId: {{item_id}}
    }
  
    headers: {
      x-user-ou: {{ou_id}}
      x-user-branch: {{branch_id}}
      x-user-id: {{user_id}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
  
      '''
    }
  }
}

