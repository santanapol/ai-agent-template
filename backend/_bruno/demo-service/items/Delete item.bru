meta {
  name: Delete item
  type: http
  seq: 6
  tags: [
    items
  ]
}

delete {
  url: {{baseUrl}}/api/v1/items/:itemId
  body: none
  auth: apikey
}

params:path {
  itemId: {{item_id}}
}

headers {
  x-user-ou: {{ou_id}}
  x-user-branch: {{branch_id}}
  x-user-id: {{user_id}}
  If-Match: {{if_match}}
}

auth:apikey {
  key: x-gateway-secret
  value: {{apiKey}}
  placement: header
}

docs {
  Deletes an item when `If-Match` matches the current weak ETag.
}

example {
  name: 200 Response
  description: Deleted
  
  request: {
    url: {{baseUrl}}/api/v1/items/:itemId
    method: DELETE
    mode: none
    params:path: {
      itemId: {{item_id}}
    }
  
    headers: {
      x-user-ou: {{ou_id}}
      x-user-branch: {{branch_id}}
      x-user-id: {{user_id}}
      If-Match: {{if_match}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
  
      '''
    }
  }
}

