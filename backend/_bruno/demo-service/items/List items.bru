meta {
  name: List items
  type: http
  seq: 1
  tags: [
    items
  ]
}

get {
  url: {{baseUrl}}/api/v1/items
  body: none
  auth: apikey
}

headers {
  x-user-ou: {{ou_id}}
  x-user-branch: {{branch_id}}
  x-user-id: {{user_id}}
}

auth:apikey {
  key: x-gateway-secret
  value: {{apiKey}}
  placement: header
}

docs {
  Paginated list of items scoped to the caller tenant (`ou_id` + `branch_id`).
}

example {
  name: ok
  
  request: {
    url: {{baseUrl}}/api/v1/items
    method: GET
    mode: none
    headers: {
      x-user-ou: {{ou_id}}
      x-user-branch: {{branch_id}}
      x-user-id: {{user_id}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "code": "SUCCESS",
          "message": null,
          "data": [
            {
              "id": "507f1f77bcf86cd799439011",
              "code": "ITEM-001",
              "name": "Demo",
              "description": null,
              "status": "draft",
              "tags": []
            }
          ],
          "pagination": {
            "page": 1,
            "limit": 20,
            "total": 1,
            "totalPages": 1
          }
        }
      '''
    }
  }
}

