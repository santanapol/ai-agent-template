example {
  name: rateLimited
  
  request: {
    url: {{baseUrl}}/api/v1/items
    method: GET
    mode: none
    headers: {
      x-user-ou: {{ou_id}}
      x-user-branch: {{branch_id}}
      x-user-id: {{user_id}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 429
      text: Too Many Requests
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "code": "TOO_MANY_REQUESTS",
          "message": "Too many requests, please try again later.",
          "data": null,
          "requestId": "018f3c2e-0000-7000-8000-000000000006"
        }
      '''
    }
  }
}

