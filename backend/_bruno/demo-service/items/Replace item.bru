meta {
  name: Replace item
  type: http
  seq: 4
  tags: [
    items
  ]
}

put {
  url: {{baseUrl}}/api/v1/items/:itemId
  body: json
  auth: apikey
}

params:path {
  itemId: {{item_id}}
}

headers {
  x-user-ou: {{ou_id}}
  x-user-branch: {{branch_id}}
  x-user-id: {{user_id}}
  If-Match: {{if_match}}
}

auth:apikey {
  key: x-gateway-secret
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "code": "",
    "name": "",
    "description": "",
    "status": "draft",
    "tags": []
  }
}

docs {
  Full document replace (not JSON Merge Patch). Documented exception to the default “no `PUT`”
  policy — see [`docs/adrs/001-put-full-replace.md`](./docs/adrs/001-put-full-replace.md).
  
}

example {
  name: 200 Response
  description: Success
  
  request: {
    url: {{baseUrl}}/api/v1/items/:itemId
    method: PUT
    mode: json
    params:path: {
      itemId: {{item_id}}
    }
  
    headers: {
      x-user-ou: {{ou_id}}
      x-user-branch: {{branch_id}}
      x-user-id: {{user_id}}
      If-Match: {{if_match}}
    }
  
    body:json: {
      {
        "code": "",
        "name": "",
        "description": "",
        "status": "draft",
        "tags": []
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
  
      '''
    }
  }
}

example {
  name: invalid
  
  request: {
    url: {{baseUrl}}/api/v1/items/:itemId
    method: PUT
    mode: json
    params:path: {
      itemId: {{item_id}}
    }
  
    headers: {
      x-user-ou: {{ou_id}}
      x-user-branch: {{branch_id}}
      x-user-id: {{user_id}}
      If-Match: {{if_match}}
    }
  
    body:json: {
      {
        "code": "",
        "name": "",
        "description": "",
        "status": "draft",
        "tags": []
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "code": "INVALID_PARAM",
          "message": "Validation failed",
          "data": {
            "errors": [
              {
                "path": "code",
                "code": "REQUIRED",
                "message": "Field is required"
              }
            ]
          },
          "requestId": "018f3c2e-0000-7000-8000-000000000004"
        }
      '''
    }
  }
}

