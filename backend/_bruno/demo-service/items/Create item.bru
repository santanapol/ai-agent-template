example {
  name: dup
  
  request: {
    url: {{baseUrl}}/api/v1/items
    method: POST
    mode: json
    headers: {
      x-user-ou: {{ou_id}}
      x-user-branch: {{branch_id}}
      x-user-id: {{user_id}}
    }
  
    body:json: {
      {
        "code": "",
        "name": "",
        "description": "",
        "status": "draft",
        "tags": []
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "code": "DUPLICATE",
          "message": "Example item code already exists for this tenant",
          "data": null,
          "requestId": "018f3c2e-0000-7000-8000-000000000005"
        }
      '''
    }
  }
}

