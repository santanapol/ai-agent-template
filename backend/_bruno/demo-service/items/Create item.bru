meta {
  name: Create item
  type: http
  seq: 2
  tags: [
    items
  ]
}

post {
  url: {{baseUrl}}/api/v1/items
  body: json
  auth: apikey
}

headers {
  x-user-ou: {{ou_id}}
  x-user-branch: {{branch_id}}
  x-user-id: {{user_id}}
}

auth:apikey {
  key: x-gateway-secret
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "code": "",
    "name": "",
    "description": "",
    "status": "draft",
    "tags": []
  }
}

docs {
  Creates a new item with server-side audit fields and weak ETag (`upd_date`).
}

example {
  name: 201 Response
  description: Created
  
  request: {
    url: {{baseUrl}}/api/v1/items
    method: POST
    mode: json
    headers: {
      x-user-ou: {{ou_id}}
      x-user-branch: {{branch_id}}
      x-user-id: {{user_id}}
    }
  
    body:json: {
      {
        "code": "",
        "name": "",
        "description": "",
        "status": "draft",
        "tags": []
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
  
      '''
    }
  }
}

example {
  name: invalid
  
  request: {
    url: {{baseUrl}}/api/v1/items
    method: POST
    mode: json
    headers: {
      x-user-ou: {{ou_id}}
      x-user-branch: {{branch_id}}
      x-user-id: {{user_id}}
    }
  
    body:json: {
      {
        "code": "",
        "name": "",
        "description": "",
        "status": "draft",
        "tags": []
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "code": "INVALID_PARAM",
          "message": "Validation failed",
          "data": {
            "errors": [
              {
                "path": "code",
                "code": "REQUIRED",
                "message": "Field is required"
              }
            ]
          },
          "requestId": "018f3c2e-0000-7000-8000-000000000004"
        }
      '''
    }
  }
}

