meta {
  name: Prometheus metrics
  type: http
  seq: 1
  tags: [
    internal
  ]
}

get {
  url: {{baseUrl}}/metrics
  body: none
  auth: bearer
}

headers {
  Accept: text/plain
}



docs {
  Prometheus text exposition; secured with `GatewaySecret` (`x-gateway-secret`).
}

example {
  name: 200 Response
  description: Prometheus text exposition format
  
  request: {
    url: {{baseUrl}}/metrics
    method: GET
    mode: none
    headers: {
      Accept: text/plain
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: missingSecret
  
  request: {
    url: {{baseUrl}}/metrics
    method: GET
    mode: none
    headers: {
      Accept: text/plain
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "code": "GATEWAY_SECRET_REJECTED",
          "message": "Authentication failed",
          "data": null,
          "requestId": "018f3c2e-0000-7000-8000-000000000002"
        }
      '''
    }
  }
}

auth:bearer {
  token: {{access_token}}
}
