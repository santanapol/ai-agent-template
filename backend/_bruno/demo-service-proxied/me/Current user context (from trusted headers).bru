meta {
  name: Current user context (from trusted headers)
  type: http
  seq: 1
  tags: [
    me
  ]
}

get {
  url: {{baseUrl}}/api/v1/me
  body: none
  auth: bearer
}

headers {

}



docs {
  Returns **`userId`**, **`ou`**, **`branch`**, and optional **`role`** parsed only from gateway-injected
  **`x-user-*`** headers — never from the request body.
  
}

example {
  name: ok
  
  request: {
    url: {{baseUrl}}/api/v1/me
    method: GET
    mode: none
    headers: {

    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "code": "SUCCESS",
          "message": null,
          "data": {
            "userId": "user-001",
            "ou": "ou-001",
            "branch": "bkk-01",
            "role": "analyst"
          }
        }
      '''
    }
  }
}

