meta {
  name: Create profile (via gateway)
  type: http
  seq: 2
  tags: [
    profiles
  ]
}

post {
  url: {{baseUrl}}/api/v1/staff/profiles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "code": "",
    "firstname": "",
    "lastname": "",
    "email": "",
    "tel": "",
    "user_id": "",
    "username": "",
    "password": ""
  }
}

docs {
  Admin create endpoint.
  - Link mode: provide `user_id`, do not send `username`/`password`.
  - Provision mode: omit `user_id` and send `username` + `password`.
  
}

example {
  name: 201 Response
  description: Created
  
  request: {
    url: {{baseUrl}}/api/v1/staff/profiles
    method: POST
    mode: json
    body:json: {
      {
        "code": "",
        "firstname": "",
        "lastname": "",
        "email": "",
        "tel": "",
        "user_id": "",
        "username": "",
        "password": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
  
      '''
    }
  }
}

