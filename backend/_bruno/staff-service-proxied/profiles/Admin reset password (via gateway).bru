meta {
  name: Admin reset password (via gateway)
  type: http
  seq: 7
  tags: [
    profiles
  ]
}

post {
  url: {{baseUrl}}/api/v1/staff/profiles/:profileId/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "password": "",
    "revoke_sessions": false
  }
}

docs {
  Admin-only password reset for another profile; returns `204` on success.
}

example {
  name: 204 Response
  description: Password updated
  
  request: {
    url: {{baseUrl}}/api/v1/staff/profiles/:profileId/password
    method: POST
    mode: json
    body:json: {
      {
        "password": "",
        "revoke_sessions": false
      }
    }
  }
  
  response: {
    status: {
      code: 204
      text: No Content
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

