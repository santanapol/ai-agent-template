meta {
  name: List or lookup profiles (via gateway)
  type: http
  seq: 1
  tags: [
    profiles
  ]
}

get {
  url: {{baseUrl}}/api/v1/staff/profiles
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

