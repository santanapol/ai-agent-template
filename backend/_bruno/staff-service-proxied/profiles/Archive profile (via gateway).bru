meta {
  name: Archive profile (via gateway)
  type: http
  seq: 5
  tags: [
    profiles
  ]
}

post {
  url: {{baseUrl}}/api/v1/staff/profiles/:profileId/archive
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  If-Match: "2026-05-28T00:00:00.000Z"
}

docs {
  Admin lifecycle action with `If-Match`.
  Persists archived status first, then revokes auth sessions; revoke failure returns
  `503 STAFF_AUTH_REVOKE_PENDING`.
  
}

