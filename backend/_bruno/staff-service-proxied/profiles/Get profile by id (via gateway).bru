meta {
  name: Get profile by id (via gateway)
  type: http
  seq: 3
  tags: [
    profiles
  ]
}

get {
  url: {{baseUrl}}/api/v1/staff/profiles/:profileId
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Returns one profile by `profileId` when caller tenant scope is allowed.
}

