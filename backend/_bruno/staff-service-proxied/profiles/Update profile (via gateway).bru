meta {
  name: Update profile (via gateway)
  type: http
  seq: 4
  tags: [
    profiles
  ]
}

patch {
  url: {{baseUrl}}/api/v1/staff/profiles/:profileId
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  If-Match: "2026-05-28T00:00:00.000Z"
}

body:json {
  {
    "code": "",
    "firstname": "",
    "lastname": "",
    "email": "",
    "tel": ""
  }
}

docs {
  Partial update with optimistic concurrency via `If-Match` (ETag).
}

example {
  name: 200 Response
  description: Success
  
  request: {
    url: {{baseUrl}}/api/v1/staff/profiles/:profileId
    method: PATCH
    mode: json
    headers: {
      If-Match: "2026-05-28T00:00:00.000Z"
    }

    body:json: {
      {
        "code": "",
        "firstname": "",
        "lastname": "",
        "email": "",
        "tel": ""
      }
    }
  }
  
