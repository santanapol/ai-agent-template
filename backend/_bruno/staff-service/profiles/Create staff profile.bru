meta {
  name: Create staff profile
  type: http
  seq: 2
  tags: [
    profiles
  ]
}

post {
  url: {{baseUrl}}/api/v1/staff/profiles
  body: json
  auth: apikey
}

headers {
  x-user-ou: {{ou_id}}
  x-user-branch: {{branch_id}}
  x-user-id: {{user_id}}
  x-user-role: {{role}}
}

auth:apikey {
  key: x-gateway-secret
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "code": "",
    "firstname": "",
    "lastname": "",
    "email": "",
    "tel": "",
    "user_id": "",
    "username": "",
    "password": ""
  }
}

docs {
  Admin create. When `user_id` is omitted, **`username`** and **`password`** are required (provision via auth internal).
  When `user_id` is provided, link an existing auth user (no `username` / `password`).
  
}

example {
  name: 201 Response
  description: Created
  
  request: {
    url: {{baseUrl}}/api/v1/staff/profiles
    method: POST
    mode: json
    headers: {
      x-user-ou: {{ou_id}}
      x-user-branch: {{branch_id}}
      x-user-id: {{user_id}}
      x-user-role: {{role}}
    }
  
    body:json: {
      {
        "code": "",
        "firstname": "",
        "lastname": "",
        "email": "",
        "tel": "",
        "user_id": "",
        "username": "",
        "password": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
  
      '''
    }
  }
}

