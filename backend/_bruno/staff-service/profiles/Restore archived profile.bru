meta {
  name: Restore archived profile
  type: http
  seq: 6
  tags: [
    profiles
  ]
}

post {
  url: {{baseUrl}}/api/v1/staff/profiles/:profileId/restore
  body: none
  auth: apikey
}

params:path {
  profileId: {{profile_id}}
}

headers {
  x-user-ou: {{ou_id}}
  x-user-branch: {{branch_id}}
  x-user-id: {{user_id}}
  x-user-role: {{role}}
  If-Match: "2026-05-28T00:00:00.000Z"
}

auth:apikey {
  key: x-gateway-secret
  value: {{apiKey}}
  placement: header
}

docs {
  Sets `status` to `active` with optimistic concurrency (`If-Match`).
}

example {
  name: 200 Response
  description: Restored to active
  
  request: {
    url: {{baseUrl}}/api/v1/staff/profiles/:profileId/restore
    method: POST
    mode: none
    params:path: {
      profileId: {{profile_id}}
    }
  
    headers: {
      x-user-ou: {{ou_id}}
      x-user-branch: {{branch_id}}
      x-user-id: {{user_id}}
      x-user-role: {{role}}
      If-Match: "2026-05-28T00:00:00.000Z"
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
  
      '''
    }
  }
}

