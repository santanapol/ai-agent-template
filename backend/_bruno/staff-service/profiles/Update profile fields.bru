meta {
  name: Update profile fields
  type: http
  seq: 4
  tags: [
    profiles
  ]
}

patch {
  url: {{baseUrl}}/api/v1/staff/profiles/:profileId
  body: json
  auth: apikey
}

params:path {
  profileId: {{profile_id}}
}

headers {
  x-user-ou: {{ou_id}}
  x-user-branch: {{branch_id}}
  x-user-id: {{user_id}}
  x-user-role: {{role}}
  If-Match: "2026-05-28T00:00:00.000Z"
}

auth:apikey {
  key: x-gateway-secret
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "code": "",
    "firstname": "",
    "lastname": "",
    "email": "",
    "tel": ""
  }
}

docs {
  Partial update with **`If-Match`** (weak ETag from `upd_date`).
  Own profile: `code` in body is ignored. **Do not** send `status` or `password` here.
  
}

example {
  name: 200 Response
  description: Success
  
  request: {
    url: {{baseUrl}}/api/v1/staff/profiles/:profileId
    method: PATCH
    mode: json
    params:path: {
      profileId: {{profile_id}}
    }
  
    headers: {
      x-user-ou: {{ou_id}}
      x-user-branch: {{branch_id}}
      x-user-id: {{user_id}}
      x-user-role: {{role}}
      If-Match: "2026-05-28T00:00:00.000Z"
    }
  
    body:json: {
      {
        "code": "",
        "firstname": "",
        "lastname": "",
        "email": "",
        "tel": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
  
      '''
    }
  }
}

