meta {
  name: List or lookup staff profiles
  type: http
  seq: 1
  tags: [
    profiles
  ]
}

get {
  url: {{baseUrl}}/api/v1/staff/profiles
  body: none
  auth: apikey
}

params:query {
  status: active
  sort: -upd_date
  page: 1
  limit: 20
  ~user_id: 
  ~status: archived
  ~status: all
  ~branch_id: 
  ~q: 
}

headers {
  x-user-ou: {{ou_id}}
  x-user-branch: {{branch_id}}
  x-user-id: {{user_id}}
  x-user-role: {{role}}
}

auth:apikey {
  key: x-gateway-secret
  value: {{apiKey}}
  placement: header
}

docs {
  **List mode** (admin): omit `user_id` — supports `q`, `status`, `branch_id`, `sort`, pagination.
  **`staff` role:** `403 INVALID_USER_CONTEXT`.
  
  **Lookup mode:** `user_id={hex24}` — returns a single profile object (no `pagination`).
  **Do not** combine `user_id` with list query parameters (`q`, `page`, …) → `400 INVALID_PARAM`.
  
}

example {
  name: 200 Response
  description: Success (list array or single lookup object in `data`)
  
  request: {
    url: {{baseUrl}}/api/v1/staff/profiles
    method: GET
    mode: none
    params:query: {
      ~user_id: 
      status: active
      ~status: archived
      ~status: all
      ~branch_id: 
      ~q: 
      sort: -upd_date
      page: 1
      limit: 20
    }
  
    headers: {
      x-user-ou: {{ou_id}}
      x-user-branch: {{branch_id}}
      x-user-id: {{user_id}}
      x-user-role: {{role}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
  
      '''
    }
  }
}

