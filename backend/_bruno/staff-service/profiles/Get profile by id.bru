meta {
  name: Get profile by id
  type: http
  seq: 3
  tags: [
    profiles
  ]
}

get {
  url: {{baseUrl}}/api/v1/staff/profiles/:profileId
  body: none
  auth: apikey
}

params:path {
  profileId: {{profile_id}}
}

headers {
  x-user-ou: {{ou_id}}
  x-user-branch: {{branch_id}}
  x-user-id: {{user_id}}
  x-user-role: {{role}}
}

auth:apikey {
  key: x-gateway-secret
  value: {{apiKey}}
  placement: header
}

docs {
  Returns one profile when it exists within caller tenant scope.
}

example {
  name: 200 Response
  description: Success
  
  request: {
    url: {{baseUrl}}/api/v1/staff/profiles/:profileId
    method: GET
    mode: none
    params:path: {
      profileId: {{profile_id}}
    }
  
    headers: {
      x-user-ou: {{ou_id}}
      x-user-branch: {{branch_id}}
      x-user-id: {{user_id}}
      x-user-role: {{role}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
  
      '''
    }
  }
}

