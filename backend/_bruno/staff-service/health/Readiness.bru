meta {
  name: Readiness
  type: http
  seq: 2
  tags: [
    health
  ]
}

get {
  url: {{baseUrl}}/readyz
  body: none
  auth: inherit
}

docs {
  MongoDB ping; returns 503 when database is unreachable.
}

example {
  name: 200 Response
  description: Ready
  
  request: {
    url: {{baseUrl}}/readyz
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "code": "",
          "message": "",
          "data": "",
          "pagination": {
            "page": 0,
            "limit": 0,
            "total": 0,
            "totalPages": 0
          },
          "requestId": ""
        }
      '''
    }
  }
}

example {
  name: 503 Response
  description: Dependency unavailable
  
  request: {
    url: {{baseUrl}}/readyz
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 503
      text: Service Unavailable
    }
  
    body: {
      type: json
      content: '''
  
      '''
    }
  }
}
