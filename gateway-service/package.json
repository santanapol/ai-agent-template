{
  "name": "gateway-service",
  "version": "0.1.1",
  "private": true,
  "description": "API Gateway — verify JWT (JWKS), inject trusted headers, proxy to upstreams",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "lint": "eslint .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest",
    "dev:upstream": "node scripts/dev-upstream.mjs",
    "try:proxy": "node scripts/try-proxy.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/http-proxy": "^11.4.4",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "joi": "^17.13.3",
    "jose": "^5.10.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "jest": "^29.7.0"
  }
}
