# =============================================================================
# gateway-service — environment template
# คัดลอกเป็น `.env` แล้วแก้ค่า — ห้าม commit secret production
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3002
TRUST_PROXY=false
# LOG_LEVEL=info
# LOG_PRETTY=true

# -----------------------------------------------------------------------------
# JWT verify (JWKS only — ห้ามตั้ง JWT_SECRET)
# -----------------------------------------------------------------------------
# ต้องตรงกับ JWKS ของ auth-service (ลงท้าย `/.well-known/jwks.json`)
JWT_JWKS_URL=http://127.0.0.1:3001/.well-known/jwks.json

# ถ้าตั้งแล้ว ต้องตรงกับ access token ที่ auth-service ออก
# JWT_ISSUER=https://auth.example.invalid
# JWT_AUDIENCE=gateway

JWT_CLAIM_USER_ID=sub
JWT_CLAIM_ROLE=role
# JWT_LEEWAY_SECONDS=60

# -----------------------------------------------------------------------------
# Gateway → upstream trust contract
# -----------------------------------------------------------------------------
# ควรใช้ random ≥ 32 bytes — ต้องตรงกับค่าที่ internal service ตรวจ
GATEWAY_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes

# -----------------------------------------------------------------------------
# Proxy / limits
# -----------------------------------------------------------------------------
UPSTREAM_TIMEOUT_MS=30000
MAX_BODY_BYTES=1048576

# ตั้งอย่างใดอย่างหนึ่งเท่านั้น: ROUTES_JSON หรือ ROUTES_FILE
# internal-api (GET /api/v1/me) — stripPrefix false เพื่อให้ path ตรงกับ upstream
ROUTES_JSON=[{"prefix":"/api","upstream":"http://127.0.0.1:4010","stripPrefix":false}]
# mock echo (GET /api/ping → upstream /ping): [{"prefix":"/api","upstream":"http://127.0.0.1:4000","stripPrefix":true}]
# ROUTES_FILE=./routes.example.json

# -----------------------------------------------------------------------------
# CORS (ว่าง = ปิด)
# CORS_ORIGINS=http://localhost:5173
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Shutdown
# -----------------------------------------------------------------------------
# SHUTDOWN_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# ลอง proxy ครบ (auth + internal-api + gateway)
# -----------------------------------------------------------------------------
# Terminal 1: auth-service     `npm start`           (:3001)
# Terminal 2: internal-api   `npm start`           (:4010, GATEWAY_SECRET ตรงกับด้านบน)
# Terminal 3: gateway        `npm start`           (:3002)
# Terminal 4: `npm run try:proxy`  (login demo → GET /api/v1/me)
#
# Optional: TRY_AUTH_URL, TRY_GATEWAY_URL, TRY_PROXY_PATH, TRY_LOGIN_USERNAME, TRY_LOGIN_PASSWORD
