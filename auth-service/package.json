{
  "name": "auth-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "lint": "eslint .",
    "test": "node --test --test-timeout=120000 test/**/*.test.js",
    "seed:user": "node --env-file=.env scripts/seed-user.mjs",
    "seed:example": "node --env-file=.env scripts/seed-example-data.mjs",
    "create-env": "node scripts/create-dev-env.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "argon2": "^0.41.1",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "joi": "^17.13.3",
    "jose": "^5.10.0",
    "mongodb": "^6.12.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "mongodb-memory-server": "^10.1.4"
  }
}
