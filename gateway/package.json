{
  "name": "gateway",
  "version": "0.2.1",
  "private": true,
  "description": "API Gateway — verify JWT (JWKS), inject trusted headers, proxy to upstreams",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "start": "TZ=UTC node --enable-source-maps --env-file=.env src/server.js",
    "dev": "TZ=UTC node --enable-source-maps --watch --env-file=.env src/server.js",
    "lint": "eslint .",
    "spec:lint": "npx -y @stoplight/spectral-cli lint openapi.yaml --ruleset ../../../_coding-standards/spectral/org-api.yaml",
    "ci": "npm run lint && npm run spec:lint && npm test",
    "test": "TZ=UTC NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "TZ=UTC NODE_OPTIONS=--experimental-vm-modules jest",
    "dev:upstream": "node scripts/dev-upstream.mjs",
    "try:proxy": "node scripts/try-proxy.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/http-proxy": "^11.4.4",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "joi": "^17.13.3",
    "jose": "^5.10.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "jest": "^29.7.0"
  }
}
