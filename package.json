{
  "name": "zero-platform",
  "private": true,
  "description": "Zero Platform monorepo — npm workspaces for shared backend packages",
  "workspaces": [
    "backend/shared/platform-roles",
    "backend/auth",
    "backend/gateway",
    "backend/service/staff",
    "backend/service/smart-report",
    "backend/service/agent-invoice"
  ],
  "scripts": {
    "install:services": "npm install",
    "test:roles": "npm test -w @zero-platform/roles"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
