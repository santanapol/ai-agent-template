{
  "name": "crud-service",
  "version": "0.1.1",
  "private": true,
  "description": "Sample CRUD upstream API (GET /api/v1/me + items CRUD) — Express + Mongo behind gateway",
  "type": "commonjs",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "TZ=UTC node --watch --enable-source-maps src/server.js",
    "start": "TZ=UTC node --enable-source-maps src/server.js",
    "test": "NODE_ENV=test TZ=UTC jest --runInBand",
    "test:unit": "NODE_ENV=test TZ=UTC jest --testPathPatterns=unit-test --passWithNoTests --runInBand",
    "test:integration": "NODE_ENV=test TZ=UTC jest --testPathPatterns=integration-test --runInBand",
    "test:integration:mongo": "NODE_ENV=test TZ=UTC jest --testPathPatterns=items.mongo.integration --runInBand",
    "test:coverage": "NODE_ENV=test TZ=UTC jest --coverage --runInBand",
    "ci:with-coverage": "npm run ci && npm run test:coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spec:lint": "spectral lint openapi.yaml --ruleset .spectral.yaml && spectral lint openapi-via-gateway.yaml --ruleset .spectral.yaml",
    "audit:check": "npm audit --audit-level=high",
    "prepare": "husky",
    "ci": "npm run lint && npm run format:check && npm run spec:lint && npm test && npm run audit:check"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "mongodb": "^7.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@stoplight/spectral-cli": "^6.15.0",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^17.0.4",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.0",
    "supertest": "^7.1.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
