{
  "name": "internal-api",
  "version": "0.1.1",
  "private": true,
  "description": "Internal REST API — trust boundary via x-gateway-secret (behind gateway-service)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "lint": "eslint .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "dependencies": {
    "express": "^4.21.2",
    "joi": "^17.13.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.4"
  }
}
