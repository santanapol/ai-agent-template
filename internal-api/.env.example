# internal-api — copy to `.env` (do not commit secrets)
#
# OpenAPI (แยกมุมมองเพื่อไม่สับสน):
#   docs/openapi.yaml — upstream โดยตรง (x-gateway-secret)
#   docs/openapi-via-gateway.yaml — client → gateway (Bearer JWT)

PORT=4010
TRUST_PROXY=false

# Must match gateway-service GATEWAY_SECRET (injected as x-gateway-secret)
GATEWAY_SECRET=dev-gateway-secret-change-in-production-32b!

# -----------------------------------------------------------------------------
# จับคู่กับ gateway-service (ROUTES_JSON)
# -----------------------------------------------------------------------------
# เส้นทางนี้ใช้ prefix `/api/v1` — ให้ gateway proxy แบบไม่ strip prefix ของ `/api`
# ตัวอย่าง:
#   [{"prefix":"/api","upstream":"http://127.0.0.1:4010","stripPrefix":false}]
