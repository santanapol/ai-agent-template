# Dev-mode mesh headers for staff API (direct-to-service, bypasses gateway).
# Guide: backend/ENV.md — copy to .env.local (not committed).
# In production these headers are injected by the gateway after JWT verification.

VITE_GATEWAY_SECRET=test-gateway-secret-32-chars-minimum!!
VITE_USER_OU=<your-ou-objectid>
VITE_USER_BRANCH=<your-branch-objectid>
VITE_USER_ID=<your-user-objectid>
VITE_USER_ROLE=platform_admin
