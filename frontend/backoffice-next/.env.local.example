# Local dev — copy to .env.local
# API calls use same-origin /auth and /api (Next rewrites to backend).

NEXT_PUBLIC_API_BASE_URL=

# Direct mesh bypass (optional) — same as Vite backoffice
NEXT_PUBLIC_GATEWAY_SECRET=test-gateway-secret-32-chars-minimum!!
NEXT_PUBLIC_USER_OU=
NEXT_PUBLIC_USER_BRANCH=
NEXT_PUBLIC_USER_ID=
NEXT_PUBLIC_USER_ROLE=platform_admin
