# Local dev — copy to .env.local
# API calls use same-origin /auth and /api (Next rewrites to backend).

NEXT_PUBLIC_API_BASE_URL=

# Optional dev identity hints for local harness scripts (not used in production UI)
NEXT_PUBLIC_USER_OU=
NEXT_PUBLIC_USER_BRANCH=
NEXT_PUBLIC_USER_ID=
NEXT_PUBLIC_USER_ROLE=platform_admin
